# Copie este arquivo para .env.local e preencha com os seus valores.
# NUNCA envie o .env.local para ninguém nem para o GitHub.

# Chave secreta do token de sessão (qualquer texto longo e aleatório)
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# ID da planilha: o trecho entre /d/ e /edit no link da planilha
GOOGLE_SHEETS_ID=COLE_O_ID_DA_PLANILHA_AQUI

# Opção 1 (mais fácil no seu computador): caminho do arquivo JSON da conta de serviço
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json

# Opção 2 (obrigatória na Vercel): e-mail e chave privada da conta de serviço.
# A chave fica em uma linha só, entre aspas, com \n no lugar das quebras de linha.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=portal-sonax@seu-projeto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Opcional: por quantos segundos o servidor guarda a planilha em memória (padrão 5)
# SHEETS_CACHE_SECONDS=5
