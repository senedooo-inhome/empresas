# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Opcional - caso queira conectar diretamente ao seu projeto Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=

# LOCAL BACKEND AUTHENTICATION
# Defina senhas fortes em .env.local antes de fazer login localmente.
ADMIN_PASSWORD=
AGENT_PASSWORD=
# Em produção, também defina JWT_SECRET com um valor aleatório e privado.
JWT_SECRET=
