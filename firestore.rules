rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bloqueio total de acesso direto não autenticado pelo navegador.
    // Todas as operações de leitura e escrita são intermediadas exclusivamente pelo backend autenticado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
